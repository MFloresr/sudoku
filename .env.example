# Ejemplo de variables de entorno (sin valores reales).
# La aplicación las lee del entorno del sistema: este archivo no se carga solo.
# En local basta con DJANGO_DEBUG=1; el resto es para producción.

# Clave secreta de Django (obligatoria en producción). Genera una larga y aleatoria.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# 1 para desarrollo local; en producción no se define.
DJANGO_DEBUG=1

# Conexión a PostgreSQL. Si no se define, se usa SQLite (db.sqlite3).
DATABASE_URL=

# Opcional: dominios propios, separados por comas.
DJANGO_ALLOWED_HOSTS=
# Opcional: orígenes con https para dominios propios, separados por comas.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Correo de recuperación de contraseña (Gmail con contraseña de aplicación).
# Sin esto, los correos se muestran en la consola.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
